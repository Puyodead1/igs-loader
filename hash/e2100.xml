			<feature name="data" value="/Scratch"/>
			<feature name="binary" value="SWIN"/>
			<!-- its own GLEW 1.6 and zziplib (its bundled SDL is not used) -->
			<feature name="libs" value="lib/libGLEW.so.1.6 lib/libzzip-0.so.13"/>
			<!-- its fragment shader opens with 'precision lowp float;' (GLSL ES),
			     which Mesa rejects in unversioned GLSL 1.10; 1.30 accepts it.
			     /dev/ttyS0 is the lamp board (RS232, write-only). -->
			<feature name="env" value="force_glsl_version=130 IGS_NULL_DEVS=/dev/ttyS0"/>
			<feature name="rofs_profile" value="scratch"/>
			<feature name="rofs_key" value="SwinV1.00Scratch"/>
			<!-- swin's FPGA-cipher mask (key string Hello-ScratchWin); the
			     game's own assets are not encrypted -->
			<feature name="asset_mask" value="e4be1b4e7f081654fa6b81698b039a06"/>
			<!-- the kernel runs /bin/unrar /Scratch/swin /Scratch.bin/swin and
