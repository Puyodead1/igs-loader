	<software name="scratch_m101cn">
		<description>Scratch (M101CN)</description>
		<year>2012</year>
		<publisher>IGS</publisher>
		<info name="version" value="M101CN"/>
		<info name="usage" value="docs/Scratch.md; tunable SCRATCH_COIN (credits per coin, 100)"/>
		<part name="hdd" interface="igs_hdd">
			<feature name="plugin" value="scratch"/>
			<!-- cd /Scratch; ./SWIN  (-> ../Scratch.bin/swin) -->
			<feature name="data" value="/Scratch"/>
			<feature name="binary" value="SWIN"/>
			<!-- its own GLEW 1.6 and zziplib (its bundled SDL is not used) -->
			<feature name="libs" value="lib/libGLEW.so.1.6 lib/libzzip-0.so.13"/>
			<!-- its fragment shader opens with 'precision lowp float;' (GLSL ES),
			     which Mesa rejects in unversioned GLSL 1.10; 1.30 accepts it.
			     /dev/ttyS0 is the lamp board (RS232, write-only). -->
			<feature name="env" value="force_glsl_version=130 IGS_NULL_DEVS=/dev/ttyS0"/>
			<feature name="rofs_profile" value="scratch"/>
			<feature name="rofs_key" value="SwinV1.00Scratch"/>
			<!-- swin's FPGA-cipher mask (key string Hello-ScratchWin); the
			     game's own assets are not encrypted -->
			<feature name="asset_mask" value="e4be1b4e7f081654fa6b81698b039a06"/>
			<!-- the kernel runs /bin/unrar /Scratch/swin /Scratch.bin/swin and
			     /etc/X11/IGS copies asic36.bin, before p3 covers /Scratch -->
			<feature name="build" value="root p2; decrypt /Scratch/swin /Scratch.bin/swin 1801508; copy /Scratch/asic36.bin /Scratch.bin/asic36.bin; mount p3 /Scratch"/>
			<diskarea name="harddriv">
				<disk name="e2100_scratch_m101cn" sha1="22f0c8a9a6c1bce7fae7febc3cb9f84730164e8a"/>
			</diskarea>
			<dataarea name="files">
				<rom name="/Scratch.bin/swin" size="1801508" sha1="b14064fe955318b2f4b8ac72e48e81ca4b0b564b"/>
				<rom name="/Scratch.bin/asic36.bin" size="524288" sha1="f62d2d0456cd4b845ee65eac0e70d87a00f14919"/>
			</dataarea>
		</part>
	</software>

	<software name="heroofrobots_m100fa">
		<description>Hero of Robots (M100FA)</description>
		<year>2016</year>
		<publisher>IGS</publisher>
		<info name="version" value="M100FA"/>
		<info name="usage" value="docs/HeroOfRobots.md; tunables HERO_REGION (area byte, 0x24 USA), HERO_CARD_CREDIT (points on the emulated card, 100)"/>
		<part name="hdd" interface="igs_hdd">
			<feature name="plugin" value="heroofrobots"/>
			<!-- cd /Robots/exe; ./child_linux  (-> ../../Robots.bin/child_linux) -->
			<feature name="data" value="/Robots/exe"/>
			<feature name="binary" value="child_linux"/>
			<!-- its own Ogre 1.6.1, Cg, zziplib and the NVPerfSDK stub (the
			     render-system plugins load by path from plugins.cfg), and
			     libXfont 1 from the root fs.  Host i386 Mesa, never the root
			     fs's NVIDIA libGL. -->
			<feature name="libs" value="/Robots/data/so/libOgreMain-1.6.1.so /Robots/data/so/libCg.so /Robots/data/so/libNVPerfSDK.so.1 /Robots/data/so/libzzip-0.so.13 /usr/lib/libXfont.so.1"/>
			<!-- the smart-card reader and card (games/heroofrobots/libcasmcard.c) -->
			<feature name="preload" value="libcasmcard-hero.so"/>
			<!-- Ogre uses the system libX11 from several threads: keep its locks -->
			<feature name="env" value="IGS_X11_LOCKS=1"/>
			<feature name="rofs_profile" value="heroofrobots"/>
			<feature name="rofs_key" value="RobotsHeroOfV1.0"/>
			<!-- the FPGA asset cipher (media/osmbin/*.osmenc) -->
			<feature name="asset_mask" value="4626ed14dc0ee8baed434037f7574619"/>
			<!-- p4 (ext3, writable) holds rw_data: music, videos, bookkeeping -->
			<feature name="build" value="root p2; mount p3 /Robots; mount p4 /Robots/exe/rw_data"/>
			<diskarea name="harddriv">
				<disk name="e2100_heroofrobots_m100fa" sha1="9ba1d1f99de1585d207736dbc0411671007f97bb"/>
			</diskarea>
			<dataarea name="files">
				<rom name="/Robots.bin/child_linux" size="88956077" sha1="97a19a36dcf6291717a9540501dc1bd5728a638f"/>
			</dataarea>
		</part>
	</software>

</softwarelist>
