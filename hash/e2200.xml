"Rom sets".
-->
<softwarelist name="e2200" description="IGS E2200">

	<software name="percussionmaster3_m107fa">
		<description>Percussion Master 3 (M107FA)</description>
		<year>2012</year>
		<publisher>IGS</publisher>
		<info name="version" value="M107FA"/>
		<info name="usage" value="Percussion-Master-3"/>
		<info name="tunable" value="PM3_VELOCITY int 160 level a key press reports to the drum sensors (1..255)"/>
		<info name="tunable" value="PM3_SCRIPT str - [Testing] keys on a timetable, sec:key[+],... (coin service test b1 r1 d1 m1 k0..k9 kstar khash b2 r2 d2 m2 j0..j9 jstar jhash)"/>
		<info name="tunable" value="PM3_SCRIPT_CLOCK enum:wall|frames wall [Testing] time PM3_SCRIPT in wall-clock seconds or game frames"/>
		<info name="online" value="pm3 9999"/>
		<part name="hdd" interface="igs_hdd">
			<feature name="plugin" value="percussionmaster3"/>
			<!-- /etc/X11/IGS: cd /PM3/exe; /PM3.bin/pm3 (decrypted by /PM3.bin/PowerOn) -->
			<feature name="data" value="/PM3/exe"/>
			<feature name="binary" value="/PM3.bin/pm3"/>
			<!-- its own Ogre 1.6.1, Cg, zziplib and the NVPerfSDK stub, libXfont 1 and
			     libpng 1.2 from the root fs.  Host i386 Mesa. -->
			<feature name="libs" value="/PM3/data/so/libOgreMain-1.6.1.so /PM3/data/so/libCg.so /PM3/data/so/libNVPerfSDK.so.1 /PM3/data/so/libzzip-0.so.13 /usr/lib/libXfont.so.1 /usr/lib/libpng12.so.0"/>
			<!-- Ogre uses the system libX11 from several threads: keep its locks;
			     no IP network, as on Windows (the game server is gone; with IGS_NET
			     its connection to port 9999, rewrite/netGame.cfg, goes there); its Cg
			     shaders want NVIDIA's vp40 / fp40 profiles; the cabinet's X runs 1280x720
			     (etc/X11/xorg.conf), which its fullscreen window takes as its size -->
			<feature name="env" value="IGS_X11_LOCKS=1 IGS_NO_NET=1 IGS_NET_PORTS=9999 IGS_CG_ARB=1 IGS_SCREEN=1280x720"/>
			<feature name="rofs_profile" value="pmaster3"/>
			<feature name="rofs_key" value="E2200-PMaster-V3"/>
			<!-- the FPGA cipher mask of PowerOn's key 5, which pm3 is encrypted with -->
			<feature name="exe_mask" value="3a0e2d44e578a0a81370dd147cbf2e19"/>
			<!-- the kernel mounts p2 as root; /etc/X11/IGS mounts p3 on /PM3 and p4 on
			     /PM3/rewrite; /bin/mountloop loop-mounts /PM3/ROMS/*.rom -->
			<feature name="build" value="root p2; mount p3 /PM3; loop /PM3/ROMS/exe.rom /PM3/exe; loop /PM3/ROMS/data.rom /PM3/data; loop /PM3/ROMS/*.rom /PM3/media/*; mount p4 /PM3/rewrite; poweron /PM3/exe/pm3 /PM3.bin/pm3"/>
			<diskarea name="harddriv">
				<disk name="e2200_percussionmaster3" sha1="23ba808748bab3a515096765b16e116f10cb3576"/>
			</diskarea>
			<dataarea name="files">
				<rom name="/PM3.bin/pm3" size="26092192" sha1="2b8c5c37f65267ccee2fa513874ce1af2e11b4c1"/>
			</dataarea>
		</part>
	</software>

	<software name="fishhunterskl2_m801cn">
		<description>Fish Hunter SKL2 8P (M801CN)</description>
		<year>2012</year>
		<publisher>IGS</publisher>
		<info name="version" value="M801CN"/>
		<info name="usage" value="Fish-Hunter-SKL2-8P"/>
		<info name="tunable" value="FISH_RTP str 0.95 expected return of a shot at difficulty 5 (each level up takes 0.02 off)"/>
		<info name="tunable" value="FISH_CHANCE int 300 one shot in n starts a chance game (lucky wheel, fish-hunt task, depth bomb, super golden fish or searchlight); 0 = never"/>
		<info name="tunable" value="FISH_CREDITS int 0 starting credits per station"/>
		<info name="tunable" value="FISH_CHANCE_KIND enum:0|1|3|4|5|6 0 [Testing] the chance game to start: 0 any, 1 lucky wheel, 3 fish-hunt task, 4 depth bomb, 5 super golden fish, 6 searchlight"/>
		<part name="hdd" interface="igs_hdd">
			<feature name="plugin" value="fishhunter6"/>
			<!-- FishSKLv2-8p: SKL2 for eight stations; a Sentinel HASP key; the executable is assembled at boot (E2000 style) and FPGA-encrypted -->
			<feature name="variant" value="skl2_8p"/>
			<feature name="asset_mask" value="cb0568fc51aff735e90a08ab338922ef"/>
			<feature name="rofs_profile" value="fishskl2_8p"/>
			<feature name="rofs_key" value="8PFishSKLv2InOST"/>
			<feature name="data" value="/FishSKLv2-8p"/>
			<feature name="binary" value="FHSKLv2-8p"/>
			<feature name="exe_mask" value="82137c54650dbb103575e5efaaf36644"/>
			<feature name="head_part" value="p3"/>
			<feature name="head_sector" value="1921665"/>
			<feature name="head_cipher" value="fpga"/>
			<feature name="pieces" value="851462739"/>
			<feature name="piece_file" value="/usr/lib/libshadow%s.so"/>
			<feature name="piece_mode" value="cut"/>
			<feature name="trim_kb" value="5"/>
			<feature name="trim_step" value="3"/>
			<feature name="cut_kb" value="32"/>
			<feature name="cut_step" value="-2"/>
			<!-- the kernel: /usr/bin/x86ld writes /mnt/head (p3 sector 1921665) and /mnt/GECA (p3 sector 1910562 + /sbin/smbclient); GECA cats head + the cut libshadow pieces into /FishSKLv2-8p/fish, which the kernel FPGA-decrypts into the /FishSKLv2-8pBin tmpfs -->
			<feature name="build" value="root p2; assemble /FishSKLv2-8p/fish; decrypt /FishSKLv2-8p/fish /FishSKLv2-8pBin/FHSKLv2-8p 3403004; mount p3 /FishSKLv2-8p"/>
			<diskarea name="harddriv">
				<disk name="e2200_fishhunterskl2_m801cn" sha1="901d594338f190786db7c90633e3a90ece226438"/>
			</diskarea>
			<dataarea name="files">
				<rom name="/FishSKLv2-8pBin/FHSKLv2-8p" size="3403004" sha1="63526f608f3cb0dc06d35cade18edf287ae73c54"/>
			</dataarea>
		</part>
	</software>

