		<info name="version" value="WeDo-e2000-v1-e64"/>
		<info name="usage" value="docs/WeDanceOnline2.md; tunables WEDO_REGION, WEDO_SCRIPT"/>
		<part name="hdd" interface="igs_hdd">
			<feature name="plugin" value="wedanceonline2"/>
			<feature name="data" value="/WeDo/linux"/>
			<!-- /WeDo/linux/wedo is UPX-packed; the set also holds it unpacked (step unupx) -->
			<feature name="binary" value="/WeDo/exec/wedo"/>
			<!-- SDL 1.2 and SDL_mixer linked dynamically (the host's / the loader's) -->
			<feature name="libs" value="/usr/lib/libstdc++.so.5"/>
			<!-- an online game: no IP network; cp/rm into its /tmp RAM disk run in-process,
			     other shell commands (hdparm, chmod, patcher) not; no card reader on ttyS1 -->
